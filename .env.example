# ---------------------------------------------------------------------------
# Flous Flow WhatsApp connector — environment configuration
# Copy to .env and fill in real values.
# ---------------------------------------------------------------------------

# The shared HMAC secret. MUST be identical on the Odoo server and here.
# It is set on the Odoo server via the FLOUSFLOW_WHATSAPP_CONNECTOR_SECRET env var.
FLOUSFLOW_WHATSAPP_CONNECTOR_SECRET=change-me-to-a-long-random-secret

# Comma-separated connector session keys. Each must match the
# `connector_session_key` of a number created in the Odoo module.
WHATSAPP_SESSIONS=my-number-1,my-number-2

# Base URL of the Odoo server (from inside Docker use http://web:8069).
#ODOO_BASE_URL=http://localhost:8069

# --- Timing ----------------------------------------------------------------
#OUTBOX_POLL_SECONDS=2
#HEARTBEAT_SECONDS=30
#CONNECT_RETRY_MS=10000
#QR_REPORT_EVERY_MS=10000

# --- Ban-avoidance / rate limiting -----------------------------------------
# Delay (ms) between outbound messages (randomised between min and max).
#MIN_SEND_DELAY_MS=1500
#MAX_SEND_DELAY_MS=4000
#MAX_SENDS_PER_MINUTE=15
# Max age (hours) of the last inbound message before we stop replying (0 = off).
#CUSTOMER_WINDOW_HOURS=24

# --- Attachments -----------------------------------------------------------
#MAX_ATTACHMENT_BYTES=10485760

# --- Auto-update of WhatsApp libraries (ban avoidance) ----------------------
#AUTO_UPDATE_ENABLED=true
#AUTO_UPDATE_INTERVAL_MS=21600000

# --- Logging ----------------------------------------------------------------
#LOG_LEVEL=info
